verification/*
isabelle_cache/*
!isabelle_cache/README.md
stack_cache/*
!stack_cache/README.md

# --- Isabelle session heaps (binary, multi-GB) — NOT tracked in git.
# The heaps themselves live inside the docker container at
# /root/.isabelle/heaps/. The git-tracked record of those heaps is
# reports/golden-baseline/{walls.json, heap-sizes.txt, env.json}.
heaps/*

# Runtime artifacts produced by run.sh / isabelle_prover skill
logs/
test_output.log

# Note: reports/ is TRACKED — it's where experiment records live.
# Each experiment branches off baseline, adds reports/experiments/<id>/,
# and PRs back to main.

# Python / OS housekeeping
__pycache__/
*.pyc
.DS_Store
