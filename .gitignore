# heaps/build_log.txt IS tracked: it's the per-theory timing baseline
# we benchmark experiments against.
# To restore the heap binaries themselves, see reports/baseline-restore.md.
heaps/*
!heaps/build_log.txt
!heaps/build_log.pre-swap.txt

# Runtime artifacts produced by run.sh / isabelle_prover skill
logs/

# reports/ is organized into 4 subtrees (see reports/README.md):
#   baseline/         — pre-CSTR measurements (slow-commands, slow-proofs,
#                       scan-comparison, inventory). Mostly bulky and
#                       reproducible from heaps/build_log.txt → gitignored.
#   layer1-root-swap/ — CBaseRefine ROOT-swap evidence (critical-path
#                       pre/post pairs + early build-config exp). Tracked.
#   layer2-theory/    — theory pillar re-alignment evidence (axis 2D, DAG,
#                       simulators, baseline snapshot). Tracked.
#   layer3-lemma/     — per-tactic refinement evidence. Tracked.
reports/*
!reports/README.md
!reports/lessons-learned-*.md

# baseline/ — only the directory README is tracked; the raw measurement
# dumps are large and regenerable, so they stay untracked.
!reports/baseline/
reports/baseline/*
!reports/baseline/README.md
!reports/baseline/baseline-restore.md

# layer1-root-swap/ — all tracked
!reports/layer1-root-swap/
!reports/layer1-root-swap/**

# layer2-theory/ — all tracked
!reports/layer2-theory/
!reports/layer2-theory/**

# layer3-lemma/ — all tracked
!reports/layer3-lemma/
!reports/layer3-lemma/**

# spec-strengthen/ — spec-strengthening work (moved 2026-06 to top-level
