# a stale branch still has files there.
!spec-strengthen/
!spec-strengthen/**

# experiments/ — per-PR audit bundles (rule 5). Tracked.
!reports/experiments/
!reports/experiments/**

# golden-baseline/ — build measurement baseline. Tracked, including build logs.
!reports/golden-baseline/
