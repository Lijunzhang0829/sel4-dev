+FRAME_CONJUNCT_RE = re.compile(
+    r"\bP\s*\(\s*\w+\s+s'?\s*\)"           # P (accessor s)
+    r"|=\s*\w+\s+s\d*"                      # = accessor s (preservation form)
+)
+LE_RE = re.compile(r"(?:\\<le>|≤|<=)")
+EQ_RE = re.compile(r"(?<![<>=!])=(?!=)")
+
