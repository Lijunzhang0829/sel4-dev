{
  "command": [
    "runuser",
    "-u",
    "agent",
    "--",
    "/opt/vero/codex",
    "exec",
    "--json",
    "--skip-git-repo-check",
    "--ignore-user-config",
    "--ignore-rules",
    "--sandbox",
    "danger-full-access",
    "--add-dir",
    "/home/agent/.isabelle",
    "-m",
    "gpt-6-astra",
    "-c",
    "model_reasoning_effort=\"low\"",
    "-c",
    "web_search=\"disabled\"",
    "--disable",
    "apps",
    "--disable",
    "plugins",
    "--disable",
    "remote_plugin",
    "--disable",
    "hooks",
    "-"
  ],
  "cwd": "/sandbox",
  "persistent_session": true,
  "resume_session": false
}
